# ─────────────────────────────────────────────────────────────────
#  AI Champ — Environment Variables
#  Copy this file to .env and fill in your real credentials.
#  NEVER commit .env to git.
# ─────────────────────────────────────────────────────────────────

# Port (optional, default = 3000)
PORT=3000

# ── Fast2SMS (for SMS OTP to Indian mobile numbers) ───────────────
# Get your free API key at: https://www.fast2sms.com/
# Go to Dev API → API Key (copy the key shown there)
FAST2SMS_API_KEY=your_fast2sms_api_key_here

# ── Email OTP (Nodemailer via Gmail SMTP) ─────────────────────────
# EMAIL_USER : your Gmail address (e.g. aichamp@gmail.com)
# EMAIL_PASS : Gmail App Password (NOT your account password)
#   How to create an App Password:
#   1. Go to myaccount.google.com → Security → 2-Step Verification (enable it)
#   2. Then: myaccount.google.com → Security → App passwords
#   3. Select "Mail" + "Other (Custom name)" → Generate
#   4. Copy the 16-character password here
EMAIL_SERVICE=gmail
EMAIL_USER=your_gmail_address@gmail.com
EMAIL_PASS=your_16_char_app_password_here

# ── Android App (Play Store TWA verification) ─────────────────────
# SHA-256 fingerprint of your release keystore
# Get it: keytool -list -v -keystore aichamp-release.jks -alias aichamp
APP_SHA256_FINGERPRINT=AA:BB:CC:DD:...
